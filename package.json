{
  "name": "cloud-cicd-app",
  "version": "1.0.0",
  "description": "Containerized Node.js app with a GitHub Actions CI/CD pipeline",
  "main": "server.js",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["app.js", "store.js"]
  }
}
